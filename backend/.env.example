# PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# On Vercel, create a PostgreSQL (Neon) database in Project -> Storage and copy its URL here.
# Do not use a MongoDB URI (mongodb+srv://); this backend uses PostgreSQL via pg.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URI=
JWT_SECRET=
PORT=5000
FRONTEND_URL=
# Optional database-independent recovery login; use a unique, strong password and disable when no longer needed.
RECOVERY_USER=
RECOVERY_PASS=
